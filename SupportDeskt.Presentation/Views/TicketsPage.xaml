<Page
    x:Class="SupportDeskt.Presentation.Views.TicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

	<Grid Padding="32">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel
            Grid.Row="0"
            Spacing="6"
            Margin="0,0,0,24">

			<TextBlock
                Text="Ärenden"
                FontSize="32"
                FontWeight="SemiBold" />

			<TextBlock
                Text="Registrera, sök och filtrera supportärenden."
                Opacity="0.7" />

		</StackPanel>

		<Grid
            Grid.Row="1"
            ColumnSpacing="12"
            Margin="0,0,0,24">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="220" />
				<ColumnDefinition Width="180" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBox
                Grid.Column="0"
                Header="Rubrik"
                PlaceholderText="Ärenderubrik..."
                Text="{x:Bind ViewModel.NewTicketTitle, Mode=TwoWay}" />

			<TextBox
                Grid.Column="1"
                Header="Beskrivning"
                PlaceholderText="Beskriv problemet..."
                Text="{x:Bind ViewModel.NewTicketDescription, Mode=TwoWay}" />

			<ComboBox
                Grid.Column="2"
                Header="Kund"
                PlaceholderText="{x:Bind ViewModel.CustomersPlaceholder, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.HasCustomers, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Customers}"
                SelectedItem="{x:Bind ViewModel.NewTicketCustomer, Mode=TwoWay}">

				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name.Value}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

			<ComboBox
                Grid.Column="3"
                Header="Prioritet"
                ItemsSource="{x:Bind ViewModel.Priorities}"
                SelectedItem="{x:Bind ViewModel.NewTicketPriority, Mode=TwoWay}" />

			<Button
                Grid.Column="4"
                VerticalAlignment="Bottom"
                Content="Skapa ärende"
                Command="{x:Bind ViewModel.CreateTicketCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

		</Grid>

		<Grid
            Grid.Row="2"
            ColumnSpacing="12"
            Margin="0,0,0,16">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="220" />
				<ColumnDefinition Width="180" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBox
                Grid.Column="0"
                Header="Rubrik"
                PlaceholderText="Sök efter ärenderubrik..."
                Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay}" />

            <ComboBox
                Grid.Column="1"
                Header="Kund"
                PlaceholderText="{x:Bind ViewModel.CustomersPlaceholder, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.HasCustomers, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Customers}"
                SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name.Value}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox
                Grid.Column="2"
                Header="Status"
                PlaceholderText="Alla statusar"
                ItemsSource="{x:Bind ViewModel.Statuses}"
                SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" />

			<Button
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Content="Sök"
                Command="{x:Bind ViewModel.SearchCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

			<Button
                Grid.Column="4"
                VerticalAlignment="Bottom"
                Content="Återställ"
                Command="{x:Bind ViewModel.ResetCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

		</Grid>

        <ListView
             Grid.Row="4"
             ItemsSource="{x:Bind ViewModel.Tickets}"
             SelectionMode="None"
             IsItemClickEnabled="True"
             ItemClick="TicketsList_ItemClick">

            <ListView.ItemTemplate>
				<DataTemplate>

					<Border
                        Padding="16"
                        Margin="0,4"
                        BorderThickness="1"
                        CornerRadius="8">

						<Grid ColumnSpacing="24">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="140" />
								<ColumnDefinition Width="140" />
							</Grid.ColumnDefinitions>

							<StackPanel
                                Grid.Column="0"
                                Spacing="4">

								<TextBlock
                                    Text="{Binding Title.Value}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

								<TextBlock
                                    Text="{Binding Description.Value}"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis" />

							</StackPanel>

							<StackPanel
                                Grid.Column="1"
                                Spacing="4">

								<TextBlock
                                    Text="Status"
                                    FontWeight="SemiBold" />

								<TextBlock
                                    Text="{Binding Status}" />

							</StackPanel>

							<StackPanel
                                Grid.Column="2"
                                Spacing="4">

								<TextBlock
                                    Text="Prioritet"
                                    FontWeight="SemiBold" />

								<TextBlock
                                    Text="{Binding Priority}" />

							</StackPanel>

						</Grid>

					</Border>

				</DataTemplate>
			</ListView.ItemTemplate>

		</ListView>

	</Grid>
</Page>