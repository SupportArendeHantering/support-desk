<Page
    x:Class="SupportDeskt.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>

        <Grid
            Padding="32"
            MaxWidth="1100"
            HorizontalAlignment="Left">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!-- Header -->

            <StackPanel
                Grid.Row="0"
                Spacing="6"
                Margin="0,0,0,24">

                <TextBlock
                    Text="Översikt"
                    FontSize="32"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="En sammanfattning av alla supportärenden."
                    Opacity="0.7" />

            </StackPanel>


            <!-- Total tickets -->

            <Border
                Grid.Row="1"
                Padding="20"
                Margin="0,0,0,16"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Totalt antal ärenden"
                        FontSize="16"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="{x:Bind ViewModel.TotalTickets, Mode=OneWay}"
                        FontSize="36"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="Alla registrerade supportärenden"
                        Opacity="0.7" />

                </StackPanel>

            </Border>


            <!-- Status cards -->

            <Grid
                Grid.Row="2"
                ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- New -->

                <Border
                    Grid.Column="0"
                    Padding="20"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Nya ärenden"
                            FontSize="16"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{x:Bind ViewModel.NewTickets, Mode=OneWay}"
                            FontSize="32"
                            FontWeight="SemiBold" />

                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind ViewModel.NewTicketsPercentage, Mode=OneWay}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                Text="{x:Bind ViewModel.NewTicketsPercentage, Mode=OneWay}"
                                Opacity="0.7" />

                            <TextBlock
                                Text="% av alla ärenden"
                                Opacity="0.7" />

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- Ongoing -->

                <Border
                    Grid.Column="1"
                    Padding="20"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Pågående ärenden"
                            FontSize="16"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{x:Bind ViewModel.OngoingTickets, Mode=OneWay}"
                            FontSize="32"
                            FontWeight="SemiBold" />

                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind ViewModel.OngoingTicketsPercentage, Mode=OneWay}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                Text="{x:Bind ViewModel.OngoingTicketsPercentage, Mode=OneWay}"
                                Opacity="0.7" />

                            <TextBlock
                                Text="% av alla ärenden"
                                Opacity="0.7" />

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- Resolved -->

                <Border
                    Grid.Column="2"
                    Padding="20"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Lösta ärenden"
                            FontSize="16"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{x:Bind ViewModel.ResolvedTickets, Mode=OneWay}"
                            FontSize="32"
                            FontWeight="SemiBold" />

                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="{x:Bind ViewModel.ResolvedTicketsPercentage, Mode=OneWay}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                Text="{x:Bind ViewModel.ResolvedTicketsPercentage, Mode=OneWay}"
                                Opacity="0.7" />

                            <TextBlock
                                Text="% av alla ärenden"
                                Opacity="0.7" />

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>