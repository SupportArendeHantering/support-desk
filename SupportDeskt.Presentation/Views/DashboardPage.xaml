<Page
    x:Class="SupportDeskt.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="Page_Loaded">

    <ScrollViewer>

        <Grid
            Padding="8"
            MaxWidth="1100"
            HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!-- Header -->

            <StackPanel
                Grid.Row="0"
                Spacing="0"
                Margin="0,0,0,0">

                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Översikt"
                    FontSize="32"
                    FontWeight="SemiBold" />


            </StackPanel>


            <!-- Total tickets -->

            <Border
                Grid.Row="1"
                Padding="10"
                Margin="0,0,0,0"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel Spacing="0">

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="Totalt antal ärenden"
                        FontSize="16"
                        FontWeight="SemiBold" />
                    

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{x:Bind ViewModel.TotalTickets, Mode=OneWay}"
                        FontSize="36"
                        FontWeight="SemiBold" />
                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        Foreground="CornflowerBlue"
                        Height="6"
                        Width="180"
                        Margin="0,4,0,0"/>


                </StackPanel>

            </Border>


            <!-- Status cards -->

            <Grid
                Grid.Row="2"
                ColumnSpacing="6"
                Margin="0,0,0,28">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- New -->

                <Border
                    Grid.Column="0"
                    Padding="20"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="Nya ärenden"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="{x:Bind ViewModel.NewTickets, Mode=OneWay}"
                            FontSize="32"
                            FontWeight="SemiBold" />

                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            Foreground="#E57373"
                            Height="6"
                            Width="100"
                            Margin="0,4,0,0" />

                    </StackPanel>

                </Border>


                <!-- Ongoing -->

                <Border
                    Grid.Column="1"
                    Padding="20"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="Pågående ärenden"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="{x:Bind ViewModel.OngoingTickets, Mode=OneWay}"
                            FontSize="32"
                            FontWeight="SemiBold" />

                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            Foreground="#E6C65C"
                            Height="6"
                            Width="100"
                            Margin="0,4,0,0" />

                    </StackPanel>

                </Border>


                <!-- Resolved -->

                <Border
                    Grid.Column="2"
                    Padding="20"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="Lösta ärenden"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="{x:Bind ViewModel.ResolvedTickets, Mode=OneWay}"
                            FontSize="32"
                            FontWeight="SemiBold" />

                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            Foreground="#66BB6A"
                            Height="6"
                            Width="100"
                            Margin="0,4,0,0" />

                    </StackPanel>

                </Border>

            </Grid>


            <!-- Donut section -->

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                Spacing="10">

                <TextBlock
                    Text="Ärendefördelning"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />

                <lvc:PieChart
                    Series="{x:Bind ViewModel.Series, Mode=OneWay}"
                    Width="230"
                    Height="230"
                    Background="Transparent"
                    LegendPosition="Hidden"
                    TooltipPosition="Center"
                    HorizontalAlignment="Center" />


                <!-- Custom legend -->

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="22">


                    <!-- New -->

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="7">

                        <Ellipse
                            Width="10"
                            Height="10"
                            Fill="#E57373"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="Nya"
                            VerticalAlignment="Center" />

                    </StackPanel>


                    <!-- Ongoing -->

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="7">

                        <Ellipse
                            Width="10"
                            Height="10"
                            Fill="#E6C65C"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="Pågående"
                            VerticalAlignment="Center" />

                    </StackPanel>


                    <!-- Resolved -->

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="7">

                        <Ellipse
                            Width="10"
                            Height="10"
                            Fill="#66BB6A"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="Lösta"
                            VerticalAlignment="Center" />

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>