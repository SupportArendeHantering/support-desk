<Page
    x:Class="SupportDeskt.Presentation.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDeskt.Presentation.Views"
    xmlns:models="using:SupportDesk.Domain.Models"
    Loaded="Page_Loaded">

    <Grid Padding="32">

        <StackPanel Spacing="12">

            <TextBlock
                Text="Kunder"
                FontSize="32"
                FontWeight="SemiBold" />

            <TextBlock
                Text="Här kommer kundlistan och kundhanteringen visas."
                FontSize="16" />

            <TextBox
                Header="Customer Name"
                PlaceholderText="Customer name..."
                Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay}" />
            <TextBox
                Header="Email Address"
                PlaceholderText="Email address..."
                Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay}" />


            <Button
     Command="{x:Bind ViewModel.SaveCommand}">

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Save" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                FontSize="16" />
        </StackPanel>

    </Grid>

</Page>