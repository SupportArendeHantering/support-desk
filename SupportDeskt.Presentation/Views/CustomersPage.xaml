<Page
    x:Class="SupportDeskt.Presentation.Views.CustomersPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDeskt.Presentation.Views"
    xmlns:models="using:SupportDesk.Domain.Models"
    Loaded="Page_Loaded">

    <Grid Padding="28" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="*" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- Vänster Add New Customer -->
        <StackPanel Grid.Column="0"
                    Spacing="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

            <TextBlock Text="Add New Customer"
                       FontSize="32"
                       FontWeight="SemiBold" />

            <TextBox HorizontalAlignment="Stretch"
                     Header="Customer Name"
                     PlaceholderText="Customer name..."
                     Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay}" />

            <TextBox HorizontalAlignment="Stretch"
                     Header="Email Address"
                     PlaceholderText="Email address..."
                     Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.SaveCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Save" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       FontSize="16" />
        </StackPanel>

        <!-- Höger Customer List -->
        <StackPanel Grid.Column="1"
             Spacing="12"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
            <TextBlock Text="Customers"
                       FontSize="32"
                       FontWeight="SemiBold" />


            <ListView Grid.Column="1"
                  ItemsSource="{x:Bind ViewModel.Customers}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">


                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Customer">

                        <Expander
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch">
                            <Expander.HeaderTemplate>
                                <DataTemplate x:DataType="models:Customer">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Email}" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Expander.HeaderTemplate>

                            <StackPanel Spacing="8"
                                    HorizontalAlignment="Stretch">

                                <TextBox HorizontalAlignment="Stretch"
                                     Header="Change name to:"
                                     PlaceholderText="{x:Bind Name}"
                                     Text="{Binding ElementName=RootPage, Path=ViewModel.EditCustomerName, Mode=TwoWay}" />

                                <TextBox HorizontalAlignment="Stretch"
                                     Header="Change email to:"
                                     PlaceholderText="{x:Bind Email}"
                                     Text="{Binding ElementName=RootPage, Path=ViewModel.EditEmailAddress, Mode=TwoWay}" />

                                <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.UpdateCustomerCommand}"
                                    CommandParameter="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <SymbolIcon Symbol="Edit" />
                                        <TextBlock Text="Update" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Expander>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </StackPanel>
    </Grid>
</Page>
