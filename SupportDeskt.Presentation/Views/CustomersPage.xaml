<Page
    x:Class="SupportDeskt.Presentation.Views.CustomersPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDeskt.Presentation.Views"
    xmlns:models="using:SupportDesk.Domain.Models"
    Loaded="Page_Loaded">

    <Grid Padding="28" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Add New Customer -->
        <StackPanel Grid.Column="0"
                    Spacing="12">

            <TextBlock Text="Lägg till ny kund"
                       FontSize="32"
                       FontWeight="SemiBold" />

            <TextBox Header="Kundnamn"
                     PlaceholderText="Kundnamn..."
                     IsSpellCheckEnabled="false"
                     Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay}" />

            <TextBox Header="E-postadress"
                     PlaceholderText="E-postadress..."
                     IsSpellCheckEnabled="false"
                     Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.SaveCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Save" />
                    <TextBlock Text="Spara" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Right Customer List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="1">
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="Kunder"
                       FontSize="32"
                       FontWeight="SemiBold" />

                <ListView Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.Customers}"
                          SelectionMode="None">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Customer">

                            <Expander
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch">
                                <Expander.HeaderTemplate>
                                    <DataTemplate x:DataType="models:Customer">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Email}" FontSize="12" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>

                                <StackPanel Spacing="8"
                                    HorizontalAlignment="Stretch">

                                    <TextBox HorizontalAlignment="Stretch"
                                     Header="Ändra namn till:"
                                     PlaceholderText="{x:Bind Name}"
                                     IsSpellCheckEnabled="false"
                                     Text="{Binding ElementName=RootPage, Path=ViewModel.EditCustomerName, Mode=TwoWay}" />

                                    <TextBox HorizontalAlignment="Stretch"
                                     Header="Ändra e-post till:"
                                     PlaceholderText="{x:Bind Email}"
                                     IsSpellCheckEnabled="false"
                                     Text="{Binding ElementName=RootPage, Path=ViewModel.EditEmailAddress, Mode=TwoWay}" />

                                    <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.UpdateCustomerCommand}"
                                    CommandParameter="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <SymbolIcon Symbol="Edit" />
                                            <TextBlock Text="Uppdatera" />
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </Expander>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
