<Page
    x:Class="SupportDeskt.Presentation.Views.TicketDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

	<ScrollViewer>
		<Grid
            Padding="32"
            MaxWidth="1100"
            HorizontalAlignment="Left">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Header -->

			<StackPanel
                Grid.Row="0"
                Spacing="12"
                Margin="0,0,0,28">

				<Button
                    HorizontalAlignment="Left"
                    Content="← Tillbaka till ärenden"
                    Command="{x:Bind ViewModel.BackCommand}" />

				<TextBlock
                    Text="Ärendedetaljer"
                    FontSize="32"
                    FontWeight="SemiBold" />

				<TextBlock
                    Text="Visa och uppdatera information för supportärendet."
                    Opacity="0.7" />

			</StackPanel>

			<!-- Form -->

			<Grid
                Grid.Row="1"
                ColumnSpacing="24"
                RowSpacing="20">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!-- Rubrik -->

				<TextBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Header="Rubrik"
                    Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay}" />

				<!-- Beskrivning -->

				<TextBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Header="Beskrivning"
                    Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="100" />

				<!-- Kund -->

				<ComboBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Header="Kund"
                    PlaceholderText="Välj kund"
                    ItemsSource="{x:Bind ViewModel.Customers}"
                    SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">

					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name.Value}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

				<!-- Handläggare -->

				<ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Header="Handläggare"
                    PlaceholderText="Välj handläggare"
                    ItemsSource="{x:Bind ViewModel.Assignees}"
                    SelectedItem="{x:Bind ViewModel.SelectedAssignee, Mode=TwoWay}"
                    DisplayMemberPath="Name"
                    HorizontalAlignment="Stretch" />

				<!-- Prioritet -->

				<ComboBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Header="Prioritet"
                    ItemsSource="{x:Bind ViewModel.Priorities}"
                    SelectedItem="{x:Bind ViewModel.SelectedPriority, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

				<!-- Status -->

				<ComboBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Header="Status"
                    ItemsSource="{x:Bind ViewModel.Statuses}"
                    SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

			</Grid>

			<!-- Save / feedback -->

			<StackPanel
                Grid.Row="2"
                Spacing="12"
                Margin="0,28,0,0">

				<Button
                    Content="Spara ändringar"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

				<TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />

			</StackPanel>

		</Grid>
	</ScrollViewer>

</Page>